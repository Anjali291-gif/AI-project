# ============================================================
# FreightAI – Intelligent Freight Forecasting & Vessel Chartering
# .gitignore — maintained by Anjali291-gif
# ============================================================

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
*.so
*.egg
*.egg-info/
*.egg-link
*.manifest
*.pdb
pip-log.txt
pip-delete-this-directory.txt
.Python

# ── Virtual Environments ─────────────────────────────────────
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
.conda/
conda-meta/

# ── Secrets & Environment Variables ─────────────────────────
# Root and backend .env files
.env
.env.local
.env.production
.env.staging
# Keep .env.example files (they are templates only)
!.env.example
!frontend/.env.example
*.pem
*.key
*.crt
secrets/
credentials/
.secret*
*_credentials*

# ── Frontend / Node.js ──────────────────────────────────────
node_modules/
.npm/
.yarn-integrity
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.local

# ── Vite / Build Artifacts ───────────────────────────────────
# Exclude build outputs — static artifacts are served from cloud
frontend/dist/
frontend/build/
frontend/.cache/
frontend/.parcel-cache/
*.tsbuildinfo

# DO NOT exclude backend/dist or other non-frontend dist folders
# (there are none, but be explicit to avoid accidental exclusion)

# ── IDE & Editor files ───────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo
*~
*.bak

# ── OS Artifacts ─────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Testing & Coverage ───────────────────────────────────────
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
junit.xml
coverage.xml
*.coveragerc

# ── Logs & Temporary ─────────────────────────────────────────
*.log
logs/
*.tmp
*.temp
.cache/
*.pid

# ── Jupyter Notebooks ────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Archives ─────────────────────────────────────────────────
*.zip
*.tar.gz
*.rar
*.7z

# ============================================================
# INTENTIONALLY INCLUDED (do NOT add patterns that exclude these):
#
# backend/ml/models/freight_rate_xgb.joblib   (792 KB — primary XGBoost model)
# backend/ml/models/freight_rate_rf.joblib     (4.1 MB — Random Forest baseline)
# backend/data/historical_freight_data.csv     (703 KB — training dataset)
# backend/ml/models/model_metadata.json        (3 KB — evaluation metrics)
#
# render.yaml   — Render.com deployment blueprint (must be committed)
# .env.example  — Environment variable templates (safe to commit)
# ============================================================
