# ===========================================================
# FreightAI Frontend Environment Variables
# ===========================================================
# Copy this file to .env for local development.
# NEVER commit the actual .env file — it is in .gitignore.
#
# ── Local Development ──────────────────────────────────────
# Leave VITE_API_URL empty to use the Vite dev proxy (/api →
# http://127.0.0.1:8000). This is the recommended dev setup.
# VITE_API_URL=
#
# ── Production (Render / any cloud) ───────────────────────
# Set VITE_API_URL in your hosting dashboard (not here) to
# the public URL of your deployed FastAPI backend service.
# Example: https://freightai-backend.onrender.com
#
# This variable is consumed at BUILD TIME by Vite. When
# deploying on Render (static site), add it as an
# Environment Variable in the Render dashboard for the
# frontend service.
#
VITE_API_URL=
