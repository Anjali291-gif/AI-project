# ===========================================================
# FreightAI – Root Environment Variables Reference
# ===========================================================
# This file is a TEMPLATE only. Copy the relevant sections
# to .env files in the appropriate directories:
#   • /backend/.env   — backend / uvicorn settings
#   • /frontend/.env  — Vite build-time settings
#
# NEVER commit actual .env files — they are in .gitignore.
# ===========================================================

# ── Backend (FastAPI / uvicorn) ────────────────────────────
# Host and port for uvicorn.
# When deployed (e.g. Render), PORT is set by the platform.
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development   # development | production

# CORS — comma-separated list of allowed frontend origins.
# Leave empty or "*" to allow all origins (dev default).
# Production example: https://freightai-frontend.onrender.com
ALLOWED_ORIGINS=

# ── Frontend (Vite — consumed at BUILD TIME) ───────────────
# Public URL of the deployed FastAPI backend.
# Leave empty in development — Vite proxy handles /api calls.
# Production example: https://freightai-backend.onrender.com
VITE_API_URL=

# ── Notes ──────────────────────────────────────────────────
# ML model files and training dataset are committed to the
# repository and loaded from relative paths at runtime.
# No additional configuration is needed for ML artifacts.
